{
  "name": "nexus-world-economy-sim",
  "version": "0.1.0",
  "private": true,
  "description": "NEXUS World Economy Simulator (static prototype)",
  "scripts": {
    "dev": "http-server -c-1 -p 5173 .",
    "closure": "node scripts/run-closure.mjs",
    "horizon:70y": "node scripts/run-long-horizon.mjs",
    "build:names": "powershell -ExecutionPolicy Bypass -File scripts/build-name-pools.ps1",
    "build:map": "powershell -ExecutionPolicy Bypass -File scripts/build-inline-world-map.ps1",
    "build:assets": "npm run build:names && npm run build:map",
    "test:horizon:smoke": "node --input-type=module -e \"process.env.NEXUS_HORIZON_YEARS='5'; process.env.NEXUS_SIM_DAYS_PER_TICK='30'; process.env.NEXUS_HORIZON_OUTPUT='long-horizon-5y-smoke.json'; await import('./scripts/run-long-horizon.mjs');\"",
    "test:stability": "npm run test:domains && npm run test:architecture && npm run test:start-era && npm run test:determinism && npm run test:tier6:slice1 && npm run test:tier6:slice2 && npm run test:closure && npm run test:horizon:smoke",
    "test:determinism": "node tests/deterministic-replay-contract-check.js",
    "test:start-era": "node tests/start-era-contract-check.js",
    "test:tier6:slice1": "node tests/tier6-slice1-contract-check.js",
    "test:tier6:slice2": "node tests/tier6-slice2-contract-check.js",
    "test:domains": "node tests/sim-domain-construction-check.js",
    "test:architecture": "node tests/sim-engine-architecture-check.js",
    "test:closure": "node tests/closure-tier14-regression-check.js",
    "debug:closure:gate14": "node tests/debug-closure-gate14.js"
  },
  "devDependencies": {
    "http-server": "^14.1.1",
    "jsdom": "^26.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
